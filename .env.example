# --- CLIENT SIDE (EXPO PUBLIC) ---
EXPO_PUBLIC_CONVEX_URL=https://deafening-turtle-227.convex.cloud
# Fase 5: solo claves TEST (pk_test_...) hasta Bloque D
EXPO_PUBLIC_STRIPE_KEY_TEST=
EXPO_PUBLIC_STRIPE_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SUPPORT_WHATSAPP=
EXPO_PUBLIC_ZENDESK_SUBDOMAIN=
EXPO_PUBLIC_ZENDESK_ENABLED=false
# Google Sign-In (Web OAuth client ID — same value as GOOGLE_WEB_CLIENT_ID in Convex)
# En Google Cloud Console → APIs y servicios → Credenciales → Cliente OAuth "Aplicación web":
#   - Orígenes autorizados de JavaScript: http://localhost:8081
#   - URI de redirección autorizados:     http://localhost:8081
# (Si Expo usa otro puerto, agregá ese también. Para prod: https://tu-dominio)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Web: in Google Cloud → Web OAuth client, add:
# - Authorized JavaScript origins: http://localhost:8081 (or your Expo web port)
# - Authorized redirect URIs: same origin (makeRedirectUri logs the exact value in __DEV__)

# Apple Sign-In (web) — Services ID, NO el Bundle ID
# Ejemplo: com.fclaiba.ramgosmobile.web
EXPO_PUBLIC_APPLE_CLIENT_ID=
# Callback host (ya lo tenés como EXPO_PUBLIC_CONVEX_SITE_URL):
# Domain en Apple (sin https): academic-lapwing-311.convex.site
# Return URL: https://academic-lapwing-311.convex.site/auth/apple/callback

# --- BACKEND / CONVEX SECRETS ---
# (Configure with `npx convex env set`)

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
ALLOW_STRIPE_MOCK=false

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Zendesk
ZENDESK_ENABLED=false
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# IAP & Stores
ALLOW_IAP_MOCK=false
APPLE_BUNDLE_ID=com.fclaiba.ramgosmobile
APPLE_SHARED_SECRET=
# Sign In with Apple — audiences for JWT verify (Convex oauthApple)
# APPLE_BUNDLE_ID = native App ID (same as above)
# APPLE_SERVICES_ID = Services ID for web (same as EXPO_PUBLIC_APPLE_CLIENT_ID)
APPLE_SERVICES_ID=
# Contenido del archivo de verificación de dominio (Apple → Download)
APPLE_DOMAIN_ASSOCIATION=
# Origen de la app web en dev (fallback del callback)
APPLE_WEB_APP_ORIGIN=http://localhost:8081
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# KYC
ALLOW_KYC_MOCK=false

# Google PubSub
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
GOOGLE_PUBSUB_AUDIENCE=

# Google Sign-In (verify ID tokens server-side)
GOOGLE_WEB_CLIENT_ID=

# Server
PORT=3000

# Audit script exclusions
PLUGIN_DATA=
APPDATA=
XDG_CONFIG_HOME=
PONYTAIL_DEFAULT_MODE=
CLAUDE_CONFIG_DIR=
COPILOT_PLUGIN_DATA=
