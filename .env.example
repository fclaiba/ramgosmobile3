# --- CLIENT SIDE (EXPO PUBLIC) ---
EXPO_PUBLIC_CONVEX_URL=https://deafening-turtle-227.convex.cloud
# Stripe — una clave PUBLICABLE por modo. El toggle test/live del app sólo
# muestra los modos que tienen clave acá Y secret key en Convex.
# (Alternativa: EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY, asignada por prefijo pk_test_/pk_live_.)
EXPO_PUBLIC_STRIPE_KEY_TEST=pk_test_...
EXPO_PUBLIC_STRIPE_KEY_LIVE=pk_live_...
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SUPPORT_WHATSAPP=
EXPO_PUBLIC_ZENDESK_SUBDOMAIN=
EXPO_PUBLIC_ZENDESK_ENABLED=false
# Google Sign-In (Web OAuth client ID — same value as GOOGLE_WEB_CLIENT_ID in Convex)
# En Google Cloud Console → APIs y servicios → Credenciales → Cliente OAuth "Aplicación web":
#   - Orígenes autorizados de JavaScript: http://localhost:8081
#   - URI de redirección autorizados:     http://localhost:8081
# (Si Expo usa otro puerto, agregá ese también. Para prod: https://tu-dominio)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Web: in Google Cloud → Web OAuth client, add:
# - Authorized JavaScript origins: http://localhost:8081 (or your Expo web port)
# - Authorized redirect URIs: same origin (makeRedirectUri logs the exact value in __DEV__)

# --- BACKEND / CONVEX SECRETS ---
# (Configure with `npx convex env set`)

# Stripe
# --- Stripe bi-modal (convex/_stripeEnv.ts). Cargar con: npx convex env set VAR valor
# LIVE (producción): sk_live_ + secreto del destino snapshot + secreto del destino thin (V2)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...            # destino snapshot → https://<deployment>.convex.site/stripe-webhook
STRIPE_WEBHOOK_SECRET_THIN=whsec_...       # destino thin (v2.core.account[...]) → misma URL
# TEST (QA con tarjetas 4242…): sk_test_ + sus dos secretos
STRIPE_SECRET_KEY_TEST=sk_test_...
STRIPE_WEBHOOK_SECRET_TEST=whsec_...       # destino snapshot → https://<deployment>.convex.site/stripe-webhook-test
STRIPE_WEBHOOK_SECRET_THIN_TEST=whsec_...  # destino thin → misma URL -test
# Retorno del onboarding de Stripe Connect (deep link). Si Stripe rechaza el esquema custom, usar https://ramgos.app/connect
STRIPE_CONNECT_RETURN_URL_BASE=ramgos://connect
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
# true SÓLO en QA: permite `simulate` (pagos sin Stripe). En producción: false.
ALLOW_STRIPE_MOCK=false

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Zendesk
ZENDESK_ENABLED=false
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# IAP & Stores
ALLOW_IAP_MOCK=false
APPLE_BUNDLE_ID=com.fclaiba.ramgosmobile
APPLE_SHARED_SECRET=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# KYC
ALLOW_KYC_MOCK=false

# Google PubSub
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
GOOGLE_PUBSUB_AUDIENCE=

# Google Sign-In (verify ID tokens server-side)
GOOGLE_WEB_CLIENT_ID=

# Server
PORT=3000

# Audit script exclusions
PLUGIN_DATA=
APPDATA=
XDG_CONFIG_HOME=
PONYTAIL_DEFAULT_MODE=
CLAUDE_CONFIG_DIR=
COPILOT_PLUGIN_DATA=
