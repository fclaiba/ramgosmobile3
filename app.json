{
  "expo": {
    "name": "Ramgos App",
    "slug": "ramgos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fclaiba.ramgosmobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 1,
      "package": "com.fclaiba.ramgosmobile",
      "config": {
        "googleMaps": {
          "apiKey": "__SET_GOOGLE_MAPS_ANDROID_API_KEY__"
        }
      }
    },
    "web": {
      "favicon": "./logo.png",
      "name": "Ramgos App",
      "shortName": "Ramgos App"
    },
    "plugins": [
      "@sentry/react-native/expo",
      [
        "react-native-iap",
        {
          "paymentProvider": "Play Store"
        }
      ],
      "@sentry/react-native",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "com.fclaiba.ramgosmobile.merchant",
          "enableGooglePay": true
        }
      ],
      "expo-sharing",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "49ae7444-e479-4437-be05-fa5fdf9cf6db"
      }
    },
    "owner": "fclaiba"
  }
}
