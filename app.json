{
  "expo": {
    "name": "Ramgos App",
    "slug": "ramgos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fclaiba.ramgosmobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./logo.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 1,
      "package": "com.fclaiba.ramgosmobile",
      "config": {
        "googleMaps": {
          "apiKey": "__SET_GOOGLE_MAPS_ANDROID_API_KEY__"
        }
      }
    },
    "web": {
      "favicon": "./logo.png",
      "name": "Ramgos App",
      "shortName": "Ramgos App"
    },
    "plugins": [
      "@sentry/react-native/expo",
      "@sentry/react-native",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "com.fclaiba.ramgosmobile.merchant",
          "enableGooglePay": true
        }
      ],
      "expo-sharing",
      "expo-video",
      [
        "@react-native-google-signin/google-signin/app.plugin.js",
        {
          "iosUrlScheme": "com.googleusercontent.apps.216016729359-hgdrjnvl502jmln1abopk8mpge6vd3a2"
        }
      ],
      "expo-web-browser",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "49ae7444-e479-4437-be05-fa5fdf9cf6db"
      }
    },
    "owner": "fclaiba"
  }
}
