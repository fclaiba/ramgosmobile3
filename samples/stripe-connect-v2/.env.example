# =============================================================================
# Stripe Connect V2 sample — environment variables
# Copy this file to ".env" (cp .env.example .env) and fill in real values.
# =============================================================================

# REQUIRED — Stripe secret key (test mode).
# Get it from: https://dashboard.stripe.com/test/apikeys
# Must start with "sk_test_" for the test environment.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# REQUIRED for the /webhook route — Webhook signing secret.
# When developing locally, run:
#   stripe listen --thin-events 'v2.core.account[requirements].updated,v2.core.account[configuration.recipient].capability_status_updated' --forward-thin-to http://localhost:4242/webhook
# The CLI will print "Your webhook signing secret is whsec_..." — paste it here.
# In production, copy it from the webhook destination details in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# OPTIONAL — port used by the local Express server. Defaults to 4242.
PORT=4242
